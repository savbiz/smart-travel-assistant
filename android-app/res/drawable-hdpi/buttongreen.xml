<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" >
        <shape>
            <solid
                android:color="#00FF00" />
            <stroke
                android:width="1dp"
                android:color="#80F800" />
            <corners
                android:radius="1dp" />

        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:startColor="#00FF00"
                android:endColor="#80F800"
                android:angle="270" />
            <stroke
                android:width="2dp"
                android:color="#80F800" />
            <corners
                android:radius="1dp" />

        </shape>
    </item>
</selector>
