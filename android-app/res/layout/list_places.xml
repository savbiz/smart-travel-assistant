<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#fbceb1" >
 
    <ListView
        android:id="@android:id/list"
        android:layout_width="fill_parent"
        android:layout_height="140dp"
        android:layout_above="@+id/temperatura"
        android:layout_alignParentTop="true"
        android:background="#fbceb1"
        android:dividerHeight="2dp" />

    <Button
        android:id="@+id/btnFilter"
        style="@style/ButtonText"
        android:layout_width="160dp"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentLeft="true"
        android:layout_margin="4dp"
        android:background="@drawable/button"
        android:padding="10dp"
        android:paddingLeft="30dip"
        android:paddingRight="26dip"
        android:text="Filtra i punti di interesse!"
        android:textSize="20dp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnShowOthers"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:layout_margin="4dp"
        android:background="@drawable/button"
        android:padding="10dp"
        android:paddingLeft="30dip"
        android:paddingRight="26dip"
        android:text="Altri..."
        android:textSize="20dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/meteo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/btnFilter"
        android:layout_alignLeft="@+id/btnFilter"
        android:layout_alignRight="@+id/btnShowOthers"
        android:gravity="center_horizontal"
        android:text=""
        android:textColor="#30AB22"
        android:textSize="20dp"
        android:textStyle="bold" />
    
    <TextView
        android:id="@+id/temperatura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/meteo"
        android:layout_alignLeft="@+id/btnFilter"
        android:layout_alignRight="@+id/btnShowOthers"
        android:gravity="center_horizontal"
        android:text=""
        android:textColor="#30AB22"
        android:textSize="20dp"
        android:textStyle="bold" />
 
</RelativeLayout>