<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:fillViewport="true" >

    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="#fbceb1" >

        <!-- Registration Form -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dip" >

            <!-- Full Name -->

            <EditText
                android:id="@+id/reg_name"
                style="@style/editTextStyle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dip"
                android:layout_marginTop="5dip"
                android:hint="Nome"
                android:singleLine="true"
                android:textSize="30dp"
                 />

            <!-- Username -->

            <EditText
                android:id="@+id/reg_username"
                style="@style/editTextStyle"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dip"
                android:layout_marginTop="5dip"
                android:hint="Username"
                android:singleLine="true"
                android:textSize="30dp" />

            <!-- Age -->

            <EditText
                android:id="@+id/reg_eta"
                style="@style/editTextStyle"
                android:layout_width="128dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dip"
                android:layout_marginTop="5dip"
                android:hint="Età"
                android:inputType="number"
                android:singleLine="true"
                android:textSize="30dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" >

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="84dp" >

                     <RadioGroup
                         android:id="@+id/radioSex"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:layout_alignParentRight="true" >

                         <RadioButton
                             android:id="@+id/radioButton3"
                             style="@style/editTextStyle"
                             android:layout_width="94dp"
                             android:layout_height="wrap_content"
                             android:layout_alignLeft="@+id/radioButton4"
                             android:layout_alignParentBottom="true"
                             android:background="#B39480"
                             android:text="    M"
                             android:textColor="#92000A"
                             android:textSize="30dp" />

                         <RadioButton
                             android:id="@+id/radioButton4"
                             style="@style/editTextStyle"
                             android:layout_width="92dp"
                             android:layout_height="wrap_content"
                             android:layout_alignParentRight="true"
                             android:layout_alignParentTop="true"
                             android:layout_marginRight="58dp"
                             android:background="#B39480"
                             android:text="     F"
                             android:textColor="#92000A"
                             android:textSize="30dp" />

                     </RadioGroup>

                     <TextView
                         android:id="@+id/textView2"
                         style="@style/editTextStyle"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:layout_alignParentLeft="true"
                         android:layout_centerVertical="true"
                         android:text="  Genere"
                         android:textSize="30dp"
                         android:textColor="#92000A" />

                </RelativeLayout>
            </LinearLayout>

            <!-- Password Label -->

            <EditText
                android:id="@+id/reg_password"
                style="@style/editTextStyle"
                android:layout_width="fill_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dip"
                android:ems="10"
                android:hint="Password (Min 6 caratteri)"
                android:password="true"
                android:singleLine="true"
                android:textSize="18dp" />

            <!-- Register Button -->

            <Button
                android:id="@+id/btnRegister"
                style="@style/ButtonText"
                android:layout_width="fill_parent"
                android:layout_height="63dp"
                android:layout_margin="4dp"
                android:layout_marginTop="10dip"
                android:background="@drawable/button"
                android:padding="10dp"
                android:text="Registrati!" />

            <!-- Link to Login Screen -->

            <TextView
                android:id="@+id/link_to_login"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dip"
                android:layout_marginTop="40dip"
                android:gravity="center"
                android:text="Hai già un account? Clicca per effettuare il login!"
                android:textColor="#025f7c"
                android:textSize="40dip" />
        </LinearLayout>

        <!-- Registration Form Ends -->
    </RelativeLayout>

</ScrollView>