<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#fbceb1" >

    <TextView
        android:id="@+id/textView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:text="A cosa sei interessato?"
        android:textColor="#92000A"
        android:textSize="30dp"
        android:textStyle="bold"/>

    <TableLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true" >

       <TableRow
            android:id="@+id/tableRow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

            <Button
                android:id="@+id/btnCultura"
                android:layout_width="fill_parent"
                android:layout_height="80dp"
                android:layout_alignParentLeft="true"
                android:layout_below="@+id/textView1"
                android:background="@drawable/button"
                android:drawableLeft="@drawable/culture"
                android:paddingLeft="30dip"
                android:paddingRight="26dip"
                android:text="Cultura"
                android:textSize="30dp"
                android:textStyle="bold" />

         

        </TableRow>

        <TableRow
            android:id="@+id/tableRow2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

            <Button
                android:id="@+id/btnEventi"
                android:layout_width="fill_parent"
                android:layout_height="80dp"
                android:layout_alignParentLeft="true"
                android:layout_below="@+id/btnCibo"
                android:background="@drawable/button"
                android:drawableLeft="@drawable/event"
                android:paddingLeft="30dip"
                android:paddingRight="26dip"
                android:text=" Eventi"
                android:textSize="30dp"
                android:textStyle="bold" />
        </TableRow>

        <TableRow
            android:id="@+id/tableRow3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

            <Button
                android:id="@+id/btnSvago"
                android:layout_width="fill_parent"
                android:layout_height="80dp"
                android:layout_alignParentLeft="true"
                android:layout_below="@+id/btnCultura"
                android:background="@drawable/button"
                android:drawableLeft="@drawable/fun"
                android:paddingLeft="30dip"
                android:paddingRight="26dip"
                android:text="Svago"
                android:textSize="30dp"
                android:textStyle="bold" />
        </TableRow>

        <TableRow
            android:id="@+id/tableRow4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

            <Button
                android:id="@+id/btnCibo"
                android:layout_width="fill_parent"
                android:layout_height="80dp"
                android:layout_alignParentLeft="true"
                android:layout_below="@+id/btnSvago"
                android:background="@drawable/button"
                android:drawableLeft="@drawable/food"
                android:paddingLeft="30dip"
                android:paddingRight="26dip"
                android:text="Cibo"
                android:textSize="30dp"
                android:textStyle="bold" />
        </TableRow>
        
         <TableRow
            android:id="@+id/tableRow5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

             <Button
                 android:id="@+id/btnLoad"
                 style="@style/ButtonText"
                 android:layout_width="fill_parent"
                 android:layout_height="70dp"
                 android:layout_margin="4dp"
                 android:layout_marginBottom="20dp"
                 android:background="@drawable/button_fb"
                 android:drawableLeft="@drawable/chronology"
                 android:padding="10dp"
                 android:paddingLeft="30dip"
                 android:paddingRight="26dip"
                 android:text="  Cronologia suggerimenti"
                 android:textSize="20dp"
                 android:textStyle="bold" />
        
        </TableRow>
    </TableLayout>

</RelativeLayout>